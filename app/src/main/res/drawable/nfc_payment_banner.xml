<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="260dp" android:height="96dp" />
            <gradient
                android:angle="135"
                android:startColor="#0D1118"
                android:endColor="#131924" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#10E88A" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="56dp"
        android:height="56dp"
        android:drawable="@drawable/ic_blackbox_icon" />
</layer-list>
